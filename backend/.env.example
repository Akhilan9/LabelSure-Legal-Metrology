LABELSURE_ENVIRONMENT=development
LABELSURE_DATABASE_URL=sqlite:///./labelsure.db
LABELSURE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Generate JWT_SECRET locally with: python -m app.scripts.configure_local
# JWT_SECRET=<random secret of at least 32 bytes; never commit the value>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional development-only seed passwords; otherwise the seed prompts securely.
# LABELSURE_SEED_ADMIN_PASSWORD=
# LABELSURE_SEED_INSPECTOR_PASSWORD=
# LABELSURE_SEED_SUPERVISOR_PASSWORD=

# Deterministic declaration extraction; no external API keys required.
EXTRACTION_PIPELINE_VERSION=1

# Deterministic context preparation; no legal rules executed.
CONTEXT_PIPELINE_VERSION=1

# Demo corpus only; explicit opt-in is required to execute prototypes.
RULESET_ID=labelsure_prototype
RULESET_VERSION=1
RULE_ENGINE_VERSION=1
RULES_ALLOW_PROTOTYPES=false
